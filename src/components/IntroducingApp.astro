---
import AppPhones from './AppPhones.astro';
import StoreBadges from './StoreBadges.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div id="download" class:list={['scroll-mt-32 grid grid-cols-1 items-center gap-x-12 gap-y-16 lg:grid-cols-2', className]}>
	<div>
		<h3 class="text-3xl font-extrabold tracking-tight text-primary-crimson sm:text-4xl font-sans">Introducing the Buzbo app</h3>
		<div class="mt-6 space-y-4 text-base/7 text-gray-800">
			<p>Forget the four-bullet-points-and-a-headshot routine. Open the app, pick what you're actually into — running, cooking, gaming, whatever it is — and build a profile that looks like you.</p>
			<p>Add your skills. Add your proudest moments, the stuff you'd actually want to talk about in an interview. Show people how you work, not just what your job title says.</p>
			<p>Then Buzbo does the rest — we surface people worth connecting with each week, and you message them directly. No cold outreach, no guessing if it's worth your time.</p>
		</div>
		<StoreBadges class="mt-10" />
		<p class="mt-6 flex items-center gap-2 text-sm font-semibold text-primary-crimson">
			<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
				<path d="M16.704 5.29a.75.75 0 0 1 .006 1.06l-7.5 7.6a.75.75 0 0 1-1.07 0l-3.75-3.8a.75.75 0 1 1 1.07-1.052l3.215 3.257 6.965-7.06a.75.75 0 0 1 1.06-.005Z" clip-rule="evenodd" fill-rule="evenodd" />
			</svg>
			Free to download on iOS and Android.
		</p>
	</div>
	<div>
		<AppPhones iosSrc="/app-screen-chat-ios.webp" androidSrc="/app-screen-match-android.webp" androidTime="14:38" />
	</div>
</div>
