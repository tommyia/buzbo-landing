<ul class:list={['flex flex-wrap items-center justify-center gap-5', className]}>
	{links.map((link) => (
		<li>
			<a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} class="inline-flex text-burgundy transition-opacity hover:opacity-80">
				<svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={link.path} /></svg>
			</a>
		</li>
	))}
	<li>
		<a href="https://www.buzbo.com" target="_blank" rel="noopener noreferrer" aria-label="Website" class="inline-flex text-burgundy transition-opacity hover:opacity-80">
			<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="12" cy="12" r="10" />
				<path d="M12 2a14.5 14.5 0 000 20 14.5 14.5 0 000-20M2 12h20" />
			</svg>
		</a>
	</li>
</ul>
