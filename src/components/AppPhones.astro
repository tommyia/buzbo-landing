---
interface Props {
	/** Full iOS screenshot, 720x1565, status bar included. */
	iosSrc: string;
	/** iOS screenshot with its status bar cropped off, 720x1452. */
	androidSrc: string;
	/** Clock shown in the drawn Android status bar. */
	androidTime?: string;
	class?: string;
}

const { iosSrc, androidSrc, androidTime = '14:01', class: className } = Astro.props;

const metal = 'bg-[linear-gradient(145deg,#f4f4f5_0%,#ffffff_28%,#a1a1aa_62%,#e4e4e7_100%)] p-px';
---

<div
	class:list={[
		'relative mx-auto h-[500px] w-full max-w-[330px] sm:h-[700px] sm:max-w-[520px] lg:mx-0 lg:ml-auto',
		className,
	]}
	aria-hidden="true"
>
	<!-- Rear phone: tilted clockwise and tucked behind the front phone -->
	<div class="absolute right-4 top-8 z-0 w-[172px] origin-center rotate-[10deg] sm:right-6 sm:top-10 sm:w-[272px]">
		<div class:list={['rounded-[2.15rem] shadow-[0_22px_40px_-18px_rgba(0,0,0,0.45)] sm:rounded-[2.6rem]', metal]}>
			<div class="rounded-[2.05rem] bg-zinc-950 p-[6px] sm:rounded-[2.5rem] sm:p-2">
				<div class="relative overflow-hidden rounded-[1.65rem] bg-[#f7f3e9] sm:rounded-[2rem]">
					<div class="flex h-6 items-center justify-between px-4 text-[9px] font-medium text-gray-900 sm:h-7 sm:px-5 sm:text-[10px]">
						<span>{androidTime}</span>
						<span class="absolute left-1/2 top-1.5 size-2.5 -translate-x-1/2 rounded-full bg-zinc-900 sm:top-2 sm:size-3"></span>
						<span class="flex items-center gap-1">
							<svg viewBox="0 0 24 24" fill="currentColor" class="size-2.5 sm:size-3"><path d="M12 21 1 8a16 16 0 0 1 22 0Z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" class="size-2.5 sm:size-3"><path d="M2 22h20V2Z" /></svg>
							<svg viewBox="0 0 24 24" fill="currentColor" class="size-2.5 sm:size-3"><path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4Z" /></svg>
						</span>
					</div>
					<img src={androidSrc} alt="" width="720" height="1452" loading="eager" class="block w-full" />
					<div class="absolute inset-x-0 bottom-1.5 mx-auto h-1 w-14 rounded-full bg-gray-900/60"></div>
				</div>
			</div>
		</div>
	</div>

	<!-- Front phone: upright, overlapping the rear phone -->
	<div class="absolute left-0 top-0 z-10 w-[208px] sm:w-[318px]">
		<div class:list={['rounded-[2.5rem] shadow-[0_34px_60px_-16px_rgba(0,0,0,0.6)] sm:rounded-[3rem]', metal]}>
			<div class="rounded-[2.4rem] bg-black p-[7px] sm:rounded-[2.9rem] sm:p-[10px]">
				<div class="relative overflow-hidden rounded-[1.95rem] bg-[#f7f3e9] sm:rounded-[2.35rem]">
					<img src={iosSrc} alt="" width="720" height="1566" loading="eager" class="block w-full" />
					<div class="absolute left-1/2 top-[1.6%] h-[3.6%] w-[33%] -translate-x-1/2 rounded-full bg-black"></div>
				</div>
			</div>
		</div>
	</div>
</div>
