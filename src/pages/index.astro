---
import FaviconLinks from '../components/FaviconLinks.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import IntroducingApp from '../components/IntroducingApp.astro';
import AppPhones from '../components/AppPhones.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TeamBanner from '../components/TeamBanner.astro';
import { eventsArePublic, LUMA_EVENTS_URL } from '../lib/events/paths';
import { PAGE_SEO, SITE_NAME } from '../lib/seo';
import '../styles/global.css';

const homeSeo = PAGE_SEO.home;
const origin = Astro.url.origin;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_NAME,
	url: origin,
	logo: new URL('/brand/logo-full-crimson.png', origin).href,
	description: homeSeo.description,
	sameAs: [
		'https://www.linkedin.com/company/buzbo/',
		'https://www.instagram.com/joinbuzbo/',
		'https://www.tiktok.com/@joinbuzbo',
	],
};

// Luma until the event pages are public — the same switch as the header.
const eventsLink = eventsArePublic()
	? { href: '/events' }
	: { href: LUMA_EVENTS_URL, target: '_blank', rel: 'noopener' };
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<FaviconLinks />
		<GoogleAnalytics />
		<MetaPixel />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			title={homeSeo.title}
			description={homeSeo.description}
			keywords={homeSeo.keywords}
			image={homeSeo.image}
			jsonLd={jsonLd}
		/>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body class="font-sans antialiased">
			<div class="bg-primary-beige">
				<SiteHeader home />

				<div class="relative isolate overflow-x-clip pt-14 min-h-screen">
					<img src="/hero-bg.png" alt="" aria-hidden="true" class="absolute inset-0 -z-20 size-full object-cover" />
					<div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:gap-x-12 xl:gap-x-16 lg:px-8 lg:py-40">
						<div class="mx-auto max-w-2xl lg:mx-0 lg:w-1/2 lg:flex-none">
							<h1 class="mt-10 text-pretty text-5xl font-extrabold tracking-tight text-primary-beige sm:text-7xl font-sans">Showcase who you <span class="italic font-normal font-serif">really are.</span></h1>
							<p class="mt-8 text-pretty text-lg font-normal text-primary-beige sm:text-xl/8">Your CV says what you've done. It doesn't say who you are. Buzbo is a networking platform that lets you show what actually matters: your skills, what you're into, the work you're proud of. Companies looking for real fit find you here, not just people who tick boxes. Download the app and start building your profile today.</p>
							<StoreBadges class="mt-10" />
						</div>
					</div>
					<a href="#learn-more" class="absolute inset-x-0 bottom-20 z-10 mx-auto hidden w-fit flex-col items-center gap-2 text-primary-beige lg:flex">
						<span class="text-lg font-medium">Learn more</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
							<path d="M12 4.5v15m0 0l-6-6m6 6l6-6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>

				<section id="learn-more" aria-labelledby="two-sides-heading" class="reveal bg-primary-beige py-24 sm:py-32">
					<div class="mx-auto max-w-7xl px-6 lg:px-8">
						<h2 id="two-sides-heading" class="sr-only">How Buzbo works for professionals and businesses</h2>

						<!-- For professionals: text left, image right -->
						<div id="for-professionals" class="scroll-mt-24 grid grid-cols-1 items-center gap-x-12 gap-y-12 lg:grid-cols-2">
							<div class="lg:max-w-lg">
								<span class="inline-flex rounded-full bg-step-card px-3 py-1 text-sm font-semibold text-primary-crimson">For professionals</span>
								<h3 class="mt-6 text-pretty text-4xl tracking-tight text-primary-crimson sm:text-5xl">
									<span class="font-serif italic">Your story</span><span class="font-sans font-extrabold">, not your job history</span>
								</h3>
								<div class="mt-6 space-y-4 text-base/7 text-gray-800">
									<p>A list of jobs and bullet points only tells part of the story.</p>
									<p>On Buzbo you add what actually makes you, you: your skills, your interests, the stuff you're genuinely proud of, how you work with other people. Then we match you with people worth knowing, and you talk to them directly. No more sending your CV into a black hole and hoping.</p>
								</div>
							</div>
							<div class="flex justify-center lg:justify-end">
								<AppPhones iosSrc="/app-screen-ios.webp" androidSrc="/app-screen-android.webp" />
							</div>
						</div>

						<!-- For businesses: image left, text right -->
						<div id="for-business" class="mt-24 scroll-mt-24 grid grid-cols-1 items-center gap-x-12 gap-y-12 sm:mt-32 lg:grid-cols-2">
							<div class="order-2 flex justify-center lg:order-1 lg:justify-start">
								<div class="relative w-full max-w-sm space-y-4 rotate-[-4.95deg]">
									<!-- Prompt card -->
									<div class="relative rounded-[1.5rem] bg-white px-8 py-6 shadow-xl ring-1 ring-line">
										<p class="text-[0.7rem] font-semibold uppercase tracking-[0.15em] text-muted">Tell us about you</p>
										<p class="mt-1 text-3xl font-extrabold uppercase tracking-tight text-burgundy">What are you into?</p>
									</div>
									<!-- TV / Movies card -->
									<div class="relative rounded-[1.5rem] bg-beige px-8 py-5 shadow-xl ring-1 ring-line">
										<p class="text-2xl font-extrabold uppercase tracking-tight text-burgundy">TV / Movies</p>
									</div>
									<!-- Sport card with interest pills -->
									<div class="relative overflow-hidden rounded-[1.5rem] bg-white shadow-xl ring-1 ring-line">
										<div class="bg-beige px-8 py-4">
											<p class="text-2xl font-extrabold uppercase tracking-tight text-burgundy">Sport</p>
										</div>
										<div class="bg-white px-6 pb-6 pt-5">
											<div class="flex flex-wrap gap-2.5">
												<span class="rounded-full bg-cream px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-burgundy">Running</span>
												<span class="rounded-full bg-cream px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-burgundy">Cycling</span>
												<span class="rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-line">Tennis</span>
												<span class="rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-line">Football</span>
												<span class="rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-line">Yoga</span>
												<span class="rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-line">Climbing</span>
												<span class="rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-ink ring-1 ring-line">Swimming</span>
											</div>
										</div>
									</div>
								</div>
							</div>
							<div class="order-1 lg:order-2 lg:ml-auto lg:max-w-lg">
								<span class="inline-flex rounded-full bg-step-card px-3 py-1 text-sm font-semibold text-primary-crimson">For businesses</span>
								<h3 class="mt-6 text-pretty text-4xl tracking-tight text-primary-crimson sm:text-5xl">
									<span class="font-serif italic">Hire the person</span><span class="font-sans font-extrabold">, not the paper</span>
								</h3>
								<div class="mt-6 space-y-4 text-base/7 text-gray-800">
									<p>You've hired someone who looked great on paper and turned out to be a completely different person in the role. Everyone has.</p>
									<p>Buzbo helps founders, managers and teams get to know the person before they ever step into the room — what drives them, how they work, and what they bring to the table. So when you do sit down together, you already know they're a fit.</p>
								</div>
							</div>
						</div>
					</div>
				</section>

				<section class="reveal bg-primary-beige">
					<TeamBanner />

					<div class="mx-auto max-w-7xl px-6 lg:px-8">
						<!-- Introducing the app -->
						<IntroducingApp class="mt-24 sm:mt-32" />

						<!-- Stat -->
						<div class="mx-auto max-w-3xl pb-24 pt-24 text-center sm:pb-32 sm:pt-32">
							<h3 class="text-pretty text-3xl tracking-tight sm:text-4xl">
								<span class="font-sans font-extrabold text-primary-crimson">You're not the only one </span><span class="font-serif italic text-primary-crimson">done with the CV game</span>
							</h3>
							<p class="mt-6 text-7xl font-extrabold tracking-tight text-primary-crimson sm:text-8xl">1000 +</p>
							<p class="mt-4 text-base/7 text-gray-700">members are already on the Buzbo waitlist.<br />From first jobs to founders. From the Netherlands to anywhere.</p>
						</div>
					</div>
				</section>

				<section aria-label="Founder quotes" class="reveal bg-beige py-20 sm:py-28">
						<div class="mx-auto max-w-5xl px-6 lg:px-8">
							<!-- Quote 1: text and avatar on the right -->
							<figure class="flex items-center justify-end gap-6">
								<blockquote class="max-w-lg text-right">
									<span class="font-serif text-xl italic leading-snug text-burgundy sm:text-2xl">“We want to make networking easy and human again &amp; give people the opportunity to get hired for who they are.”</span>
									<cite class="whitespace-nowrap text-sm font-bold uppercase not-italic tracking-wide text-muted"> – Anouk, Co-Founder</cite>
								</blockquote>
								<img src="/person-2.png" alt="Anouk, co-founder" class="size-20 shrink-0 rounded-full object-cover ring-2 ring-white ring-offset-2 ring-offset-beige sm:size-24" />
							</figure>

							<!-- Quote 2: avatar on the left -->
							<figure class="mt-14 flex items-center gap-6">
								<img src="/person-1.png" alt="Shinead, co-founder" class="size-20 shrink-0 rounded-full object-cover ring-2 ring-white ring-offset-2 ring-offset-beige sm:size-24" />
								<blockquote class="max-w-lg">
									<span class="font-serif text-xl italic leading-snug text-burgundy sm:text-2xl">“A CV tells you what someone did. It never tells you who they are. We built Buzbo to fix that.”</span>
									<cite class="whitespace-nowrap text-sm font-bold uppercase not-italic tracking-wide text-muted"> – Shinead, Co-Founder</cite>
								</blockquote>
							</figure>
						</div>
					</section>

				<section aria-labelledby="community-faq-heading" class="reveal bg-primary-beige py-24 sm:py-32">
						<div class="mx-auto max-w-7xl px-6 lg:px-8">
							<!-- Community intro -->
							<div class="mx-auto max-w-2xl text-center">
								<span class="inline-flex rounded-full bg-step-card px-3 py-1 text-sm font-semibold text-primary-crimson">meet the community</span>
								<h2 id="community-faq-heading" class="mt-6 text-4xl font-extrabold tracking-tight text-primary-crimson sm:text-5xl font-sans">Buzbo happens in real life</h2>
								<p class="mt-6 text-base/7 text-gray-800">Buzbo isn't just a platform — it's a community that shows up in person. Real conversations, real connections, real energy. From meetups to events, this is where ambition meets opportunity face-to-face. Follow along, show up, and be part of it from day one.</p>
							</div>

							<!-- Photo + events card -->
							<div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-3">
								<div class="lg:col-span-2">
									<img src="/faq.png" alt="Buzbo community event" class="h-full min-h-64 w-full rounded-[2rem] object-cover" />
								</div>
								<div class="flex flex-col items-center justify-center gap-8 rounded-[2rem] bg-step-card px-8 py-12 text-center">
									<p class="font-serif text-2xl italic text-gray-900">Join events, meet people, and be part of something that's actually being built.</p>
									<a {...eventsLink} class="inline-flex rounded-full px-7 py-3 text-base font-semibold text-primary-crimson ring-2 ring-primary-crimson transition hover:bg-primary-crimson hover:text-white">See upcoming events →</a>
								</div>
							</div>

							<!-- FAQ accordion -->
							<div class="mx-auto mt-20 max-w-3xl space-y-4">
								<details class="group rounded-2xl bg-white ring-1 ring-line px-6 py-5" open>
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-gray-900">
										What is Buzbo?
										<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-5 shrink-0 text-gray-600 transition group-open:rotate-180">
											<path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</summary>
									<div class="mt-4 space-y-3 text-base/7 text-gray-700">
										<p>Buzbo is a platform that helps professionals and business managers discover new business people and new opportunities.</p>
										<p>Build a profile that reflects who you are, share what drives you and connect with people who can help shape your next step — whether that's a new role, a new client, a new hire or a new idea.</p>
									</div>
								</details>

								<details class="group rounded-2xl bg-white ring-1 ring-line px-6 py-5">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-gray-900">
										How does the matching work?
										<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-5 shrink-0 text-gray-600 transition group-open:rotate-180">
											<path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</summary>
									<div class="mt-4 space-y-3 text-base/7 text-gray-700">
										<p>Create your profile by sharing your interests, skills, ambitions and the things that matter to you.</p>
										<p>Every week, Buzbo introduces you to people who align with your goals, your way of working and what you're currently focused on.</p>
										<p>Whether you're looking for your next challenge, growing a business or expanding your network, Buzbo helps the right people find each other.</p>
									</div>
								</details>

								<details class="group rounded-2xl bg-white ring-1 ring-line px-6 py-5">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-gray-900">
										Is it free?
										<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-5 shrink-0 text-gray-600 transition group-open:rotate-180">
											<path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</summary>
									<div class="mt-4 space-y-3 text-base/7 text-gray-700">
										<p>Yes! Buzbo is free to download and use with our freemium plan, which includes all the core features you need to get started.</p>
										<p>For users who want additional features, enhanced profile customisation and more match opportunities, we'll offer a premium version.</p>
										<p>Our Buzbo events are available for a small fee, giving people the opportunity to connect through curated networking experiences.</p>
									</div>
								</details>

								<details class="group rounded-2xl bg-white ring-1 ring-line px-6 py-5">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-gray-900">
										Who is it for?
										<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-5 shrink-0 text-gray-600 transition group-open:rotate-180">
											<path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</summary>
									<p class="mt-4 text-base/7 text-gray-700">Buzbo is for professionals who want to be seen for who they are, not just their job history — and for businesses who want to hire people that are the right fit, not just the right paper. Whether you're looking for your next role or your next hire, Buzbo shows the person behind the profile.</p>
								</details>

								<details class="group rounded-2xl bg-white ring-1 ring-line px-6 py-5">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-gray-900">
										When does it launch?
										<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-5 shrink-0 text-gray-600 transition group-open:rotate-180">
											<path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</summary>
									<div class="mt-4 space-y-3 text-base/7 text-gray-700">
										<p>Buzbo launches on 1 October 2026.</p>
										<p>Download the app and be part of the Buzbo community from day one.</p>
									</div>
								</details>

								<details class="group rounded-2xl bg-white ring-1 ring-line px-6 py-5">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-gray-900">
										Is it available outside the Netherlands?
										<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-5 shrink-0 text-gray-600 transition group-open:rotate-180">
											<path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</summary>
									<div class="mt-4 space-y-3 text-base/7 text-gray-700">
										<p>Buzbo is being built in the Netherlands and will launch there first, but our vision is much bigger than that.</p>
										<p>As we grow, we plan to expand internationally, making it easier for people around the world to build meaningful professional connections.</p>
									</div>
								</details>
							</div>
						</div>
					</section>

				<SiteFooter />
			</div>
		<script is:inline>
			(function () {
				var els = document.querySelectorAll('.reveal');
				if (!('IntersectionObserver' in window)) {
					els.forEach(function (el) { el.classList.add('is-visible'); });
					return;
				}
				var io = new IntersectionObserver(function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					});
				}, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
				els.forEach(function (el) { io.observe(el); });
			})();
		</script>
	</body>
</html>
