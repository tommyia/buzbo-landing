---
interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;
const shareText = title;
const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(shareText);

const links = [
	{
		name: 'LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
		icon: 'linkedin',
	},
	{
		name: 'X',
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`,
		icon: 'x',
	},
	{
		name: 'Facebook',
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
		icon: 'facebook',
	},
	{
		name: 'WhatsApp',
		href: `https://wa.me/?text=${encodeURIComponent(`${shareText} ${url}`)}`,
		icon: 'whatsapp',
	},
];

const btnClass =
	'inline-flex size-10 items-center justify-center rounded-full bg-white text-primary-crimson ring-1 ring-primary-crimson/15 transition hover:bg-primary-crimson hover:text-white';
---

<div class="flex flex-wrap items-center gap-2">
	<p class="mr-1 text-sm font-semibold text-primary-crimson">Share</p>
	{links.map((link) => (
		<a href={link.href} target="_blank" rel="noopener noreferrer" class={btnClass} title={`Share on ${link.name}`}>
			<span class="sr-only">Share on {link.name}</span>
			{link.icon === 'linkedin' ? (
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
				</svg>
			) : null}
			{link.icon === 'x' ? (
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.725-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
				</svg>
			) : null}
			{link.icon === 'facebook' ? (
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
					<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
				</svg>
			) : null}
			{link.icon === 'whatsapp' ? (
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
				</svg>
			) : null}
		</a>
	))}
	<div class="relative">
		<button type="button" data-copy-link={url} class={btnClass}>
			<span class="sr-only" data-copy-label>Copy link</span>
			<svg data-copy-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-4">
				<path d="M8 8V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2M6 10h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<svg data-copied-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="hidden size-4">
				<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
		<span
			data-copy-tooltip
			role="status"
			class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 -translate-x-1/2 rounded-md bg-primary-crimson px-2.5 py-1 text-xs font-semibold text-primary-beige opacity-0 shadow-sm transition-opacity duration-200 after:absolute after:left-1/2 after:top-full after:-translate-x-1/2 after:border-4 after:border-transparent after:border-t-primary-crimson"
		>
			Copied
		</span>
	</div>
</div>

<script>
	async function copyText(value: string) {
		try {
			await navigator.clipboard.writeText(value);
		} catch {
			const input = document.createElement('input');
			input.value = value;
			document.body.appendChild(input);
			input.select();
			document.execCommand('copy');
			input.remove();
		}
	}

	function bindCopyLinks() {
		document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
			if (btn.dataset.bound === 'true') return;
			btn.dataset.bound = 'true';
			btn.addEventListener('click', async () => {
				const url = btn.dataset.copyLink;
				if (!url) return;
				await copyText(url);
				const label = btn.querySelector('[data-copy-label]');
				const idleIcon = btn.querySelector('[data-copy-icon]');
				const doneIcon = btn.querySelector('[data-copied-icon]');
				const tooltip = btn.parentElement?.querySelector<HTMLElement>('[data-copy-tooltip]');
				if (label) label.textContent = 'Copied';
				idleIcon?.classList.add('hidden');
				doneIcon?.classList.remove('hidden');
				tooltip?.classList.remove('opacity-0');
				tooltip?.classList.add('opacity-100');
				window.setTimeout(() => {
					if (label) label.textContent = 'Copy link';
					idleIcon?.classList.remove('hidden');
					doneIcon?.classList.add('hidden');
					tooltip?.classList.add('opacity-0');
					tooltip?.classList.remove('opacity-100');
				}, 2000);
			});
		});
	}

	function bindDiscordShare() {
		document.querySelectorAll<HTMLButtonElement>('[data-discord-share]').forEach((btn) => {
			if (btn.dataset.bound === 'true') return;
			btn.dataset.bound = 'true';
			btn.addEventListener('click', async () => {
				const text = btn.dataset.copyText;
				if (text) await copyText(text);
				window.open('https://discord.com/channels/@me', '_blank', 'noopener,noreferrer');
				const label = btn.querySelector('[data-discord-label]');
				btn.title = 'Copied — paste in Discord';
				if (label) label.textContent = 'Copied — paste in Discord';
				window.setTimeout(() => {
					btn.title = 'Share on Discord';
					if (label) label.textContent = 'Share on Discord';
				}, 2500);
			});
		});
	}

	bindCopyLinks();
	bindDiscordShare();
</script>
