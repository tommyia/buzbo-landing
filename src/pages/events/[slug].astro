---
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
	formatDayLong,
	formatDayOfMonth,
	formatMonthShort,
	formatPrice,
	formatTimeRange,
	formatUtcOffset,
	isPast,
	mapEmbedUrl,
	safeHttpUrl,
} from '../../lib/events/format';
import { checkoutLabel } from '../../lib/events/checkout';
import { checkoutApiUrl, eventsHref } from '../../lib/events/paths';
import { getPublishedEvent, getSoldOut } from '../../lib/events/queries';
import { PAGE_SEO, SITE_NAME } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;
const event = slug ? await getPublishedEvent(slug) : null;

if (!event) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const zone = event.timezone;
const canonical = new URL(eventsHref(`/${event.slug}`), Astro.url.origin).href;
const ended = isPast(event, new Date());

// Everything below comes out of the database and ends up in an href or a src.
const mapUrl = safeHttpUrl(event.map_url);
const mapEmbed = mapEmbedUrl(event);
const cover = safeHttpUrl(event.cover_image_url);

// Buying goes through buzbo-be, which decides the price and whether the ticket can
// still be had; this page only names the ticket and the person.
const checkoutApi = ended ? null : checkoutApiUrl();
const soldOut = checkoutApi ? await getSoldOut(event.id) : new Set<string>();

const place = [event.venue_name, event.city].filter(Boolean).join(', ');
const dayLong = formatDayLong(event.starts_at, zone);
const timeRange = `${formatTimeRange(event.starts_at, event.ends_at, zone)} · ${formatUtcOffset(event.starts_at, zone)}`;
const pageTitle = event.seo_title || event.title;
const pageDescription =
	event.seo_description || event.summary || [dayLong, place].filter(Boolean).join(' · ');

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: event.title,
	description: pageDescription,
	startDate: event.starts_at,
	endDate: event.ends_at ?? undefined,
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
	eventStatus: 'https://schema.org/EventScheduled',
	image: cover ?? undefined,
	url: canonical,
	location: event.venue_name
		? {
				'@type': 'Place',
				name: event.venue_name,
				address: event.venue_address ?? event.city ?? undefined,
			}
		: undefined,
	organizer: { '@type': 'Organization', name: event.host_name ?? SITE_NAME },
	offers: event.ticket_types.map((ticket) => ({
		'@type': 'Offer',
		name: ticket.name,
		price: (ticket.price_cents / 100).toFixed(2),
		priceCurrency: ticket.currency,
		url: canonical,
		availability: soldOut.has(ticket.id) ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
	})),
};

const tile = 'flex size-11 shrink-0 flex-col items-center justify-center overflow-hidden rounded-xl bg-white ring-1 ring-line';
---

<BlogLayout
	title={pageTitle}
	description={pageDescription}
	keywords={PAGE_SEO.events.keywords}
	canonical={canonical}
	image={cover ?? PAGE_SEO.events.image}
	titleSuffix="Buzbo Events"
	jsonLd={jsonLd}
>
	<article class="mx-auto max-w-5xl px-6 pt-36 pb-20 lg:px-8 lg:pt-44">
		<a href={eventsHref()} class="text-sm font-semibold text-primary-crimson hover:underline">← All events</a>

		<div class="mt-6 grid gap-10 lg:grid-cols-[22rem_1fr]">
			<aside class="lg:sticky lg:top-40 lg:self-start">
				{cover ? (
					<img src={cover} alt={event.title} class="aspect-square w-full rounded-2xl object-cover ring-1 ring-line" />
				) : (
					<div class="aspect-square w-full rounded-2xl bg-beige ring-1 ring-line" aria-hidden="true"></div>
				)}
				{event.host_name ? (
					<div class="mt-6 border-t border-line pt-4">
						<p class="text-xs font-semibold uppercase tracking-wide text-muted">Hosted by</p>
						<p class="mt-1 font-semibold text-ink">{event.host_name}</p>
					</div>
				) : null}
			</aside>

			<div class="min-w-0">
				<h1 class="font-sans text-3xl font-extrabold tracking-tight text-burgundy sm:text-4xl">{event.title}</h1>

				<div class="mt-6 flex flex-col gap-4">
					<div class="flex items-center gap-3">
						<div class={tile} aria-hidden="true">
							<span class="w-full bg-beige text-center text-[10px] font-semibold uppercase leading-4 text-muted">{formatMonthShort(event.starts_at, zone)}</span>
							<span class="text-base font-bold leading-6 text-ink">{formatDayOfMonth(event.starts_at, zone)}</span>
						</div>
						<div>
							<p class="font-semibold text-ink"><time datetime={event.starts_at}>{dayLong}</time></p>
							<p class="text-sm text-muted">{timeRange}</p>
						</div>
					</div>

					{place ? (
						<div class="flex items-center gap-3">
							<div class={tile} aria-hidden="true">
								<svg viewBox="0 0 20 20" fill="currentColor" class="size-5 text-muted">
									<path fill-rule="evenodd" clip-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" />
								</svg>
							</div>
							<div>
								<p class="font-semibold text-ink">{event.venue_name ?? event.city}</p>
								{event.venue_name && event.city ? <p class="text-sm text-muted">{event.city}</p> : null}
							</div>
						</div>
					) : null}
				</div>

				<section aria-labelledby="tickets-heading" class="mt-8 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-line">
					<h2 id="tickets-heading" class="text-xs font-semibold uppercase tracking-wide text-muted">Tickets</h2>
					<ul class="mt-3 divide-y divide-line">
						{event.ticket_types.map((ticket) => (
							<li class="flex items-start justify-between gap-4 py-3">
								<div class="min-w-0">
									<p class="font-semibold text-ink">{ticket.name}</p>
									{ticket.description ? <p class="mt-0.5 text-sm text-muted">{ticket.description}</p> : null}
								</div>
								<div class="flex shrink-0 flex-col items-end gap-2">
									<p class="font-semibold text-ink">{formatPrice(ticket.price_cents, ticket.currency)}</p>
									{!checkoutApi ? null : soldOut.has(ticket.id) ? (
										<p class="rounded-full bg-beige px-4 py-1.5 text-sm font-semibold text-disabled">Sold out</p>
									) : (
										<button
											type="button"
											data-checkout-open
											data-ticket-id={ticket.id}
											data-ticket-name={ticket.name}
											data-ticket-label={checkoutLabel(ticket.price_cents)}
											class="rounded-full bg-burgundy px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-burgundy/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy"
										>
											{checkoutLabel(ticket.price_cents)}
										</button>
									)}
								</div>
							</li>
						))}
					</ul>

					{ended ? (
						<p class="mt-4 rounded-xl bg-beige px-4 py-3 text-center text-sm font-semibold text-muted">This event has ended.</p>
					) : checkoutApi ? (
						<form data-checkout-form data-checkout-api={checkoutApi} hidden novalidate class="mt-4 rounded-xl bg-beige p-4">
							<p class="text-sm font-semibold text-ink">Your ticket: <span data-checkout-ticket></span></p>
							<input type="hidden" name="ticket_type_id" />
							<label class="mt-3 block text-sm font-semibold text-ink" for="checkout-name">Name</label>
							<input id="checkout-name" name="name" type="text" required maxlength="120" autocomplete="name" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy" />
							<label class="mt-3 block text-sm font-semibold text-ink" for="checkout-email">Email</label>
							<input id="checkout-email" name="email" type="email" required maxlength="254" autocomplete="email" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy" />
							<p class="mt-2 text-sm text-muted">We send your ticket to <strong data-checkout-email-echo class="text-ink">this address</strong>. Check it before you continue.</p>
							<p data-checkout-error role="alert" hidden class="mt-3 text-sm font-semibold text-primary-crimson"></p>
							<button type="submit" class="mt-4 flex w-full items-center justify-center rounded-full bg-primary-crimson px-7 py-3 text-base font-semibold text-white transition hover:bg-primary-crimson/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:opacity-60">
								Continue
							</button>
						</form>
					) : null}
				</section>

				{event.description_html ? (
					<section aria-labelledby="about-heading" class="mt-10">
						<h2 id="about-heading" class="border-b border-line pb-2 text-sm font-semibold text-muted">About this event</h2>
						{/* Written in buzbo-event's editor, behind the admin password, and trusted
						    as the blog's article bodies are. */}
						<div class="blog-prose mt-4" set:html={event.description_html} />
					</section>
				) : null}

				{place || event.venue_address ? (
					<section aria-labelledby="location-heading" class="mt-10">
						<h2 id="location-heading" class="border-b border-line pb-2 text-sm font-semibold text-muted">Location</h2>
						{event.venue_name ? <p class="mt-4 font-semibold text-ink">{event.venue_name}</p> : null}
						{event.venue_address ? <p class="mt-1 text-muted">{event.venue_address}</p> : null}
						{!event.venue_address && event.city ? <p class="mt-1 text-muted">{event.city}</p> : null}
						{mapEmbed ? (
							<iframe
								src={mapEmbed}
								title={`Map of ${event.venue_name ?? event.venue_address ?? event.city}`}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								class="mt-4 aspect-video w-full rounded-2xl border-0 ring-1 ring-line"
							></iframe>
						) : null}
						{mapUrl ? (
							<a href={mapUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-sm font-semibold text-primary-crimson underline underline-offset-2">Open in Maps</a>
						) : null}
					</section>
				) : null}
			</div>
		</div>
	</article>
</BlogLayout>

<script>
	// The checkout form: gather a name and an email, ask buzbo-be to hold the ticket, then
	// go where it says — Airwallex's hosted payment page for a paid ticket, the order page
	// for a free one. Card details are typed at Airwallex and never touch this site.
	import { nextStep, type CheckoutAnswer } from '../../lib/events/checkout';

	const SDK_URL = 'https://static.airwallex.com/components/sdk/v1/index.js';

	type AirwallexSdk = {
		init(options: { env: string; enabledElements: string[] }): Promise<{
			payments: { redirectToCheckout(options: Record<string, string>): void };
		}>;
	};

	let sdk: Promise<AirwallexSdk> | null = null;
	function loadSdk(): Promise<AirwallexSdk> {
		sdk ??= new Promise((resolve, reject) => {
			const script = document.createElement('script');
			script.src = SDK_URL;
			script.onload = () => resolve((window as unknown as { AirwallexComponentsSDK: AirwallexSdk }).AirwallexComponentsSDK);
			script.onerror = () => {
				sdk = null;
				reject(new Error('The payment page could not be loaded. Check your connection and try again.'));
			};
			document.head.append(script);
		});
		return sdk;
	}

	const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
	if (form) {
		const api = form.dataset.checkoutApi;
		const ticketInput = form.elements.namedItem('ticket_type_id') as HTMLInputElement;
		const nameInput = form.elements.namedItem('name') as HTMLInputElement;
		const emailInput = form.elements.namedItem('email') as HTMLInputElement;
		const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const errorBox = form.querySelector<HTMLElement>('[data-checkout-error]')!;
		const ticketName = form.querySelector<HTMLElement>('[data-checkout-ticket]')!;
		const emailEcho = form.querySelector<HTMLElement>('[data-checkout-email-echo]')!;
		let submitLabel = 'Continue';

		const fail = (message: string) => {
			errorBox.textContent = message;
			errorBox.hidden = false;
			submit.disabled = false;
			submit.textContent = submitLabel;
		};

		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-checkout-open]')) {
			button.addEventListener('click', () => {
				ticketInput.value = button.dataset.ticketId ?? '';
				ticketName.textContent = button.dataset.ticketName ?? '';
				submitLabel = button.dataset.ticketLabel === 'Register' ? 'Register' : 'Continue to payment';
				submit.textContent = submitLabel;
				errorBox.hidden = true;
				form.hidden = false;
				nameInput.focus();
			});
		}

		// Back from Airwallex restores this page as it was left: button disabled, "One
		// moment…". Put it back so the buyer can try again.
		window.addEventListener('pageshow', (event) => {
			if (!event.persisted) return;
			submit.disabled = false;
			submit.textContent = submitLabel;
		});

		emailInput.addEventListener('input', () => {
			emailEcho.textContent = emailInput.value.trim() || 'this address';
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			errorBox.hidden = true;
			if (!nameInput.value.trim()) return fail('Enter your name.');
			if (!emailInput.checkValidity() || !emailInput.value.trim()) return fail('Enter a valid email address.');

			// Disabled before the request, so a second click cannot hold a second ticket.
			submit.disabled = true;
			submit.textContent = 'One moment…';
			try {
				const response = await fetch(`${api}/api/payments/checkout`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						ticket_type_id: ticketInput.value,
						name: nameInput.value,
						email: emailInput.value,
					}),
				});
				const body = (await response.json().catch(() => null)) as {
					data: CheckoutAnswer | null;
					error: { message?: string } | null;
				} | null;
				if (response.status === 400) {
					// buzbo-be's own wording here is "Request validation failed".
					throw new Error('Check your name and email address. A name cannot contain a web address.');
				}
				if (!response.ok || !body?.data) {
					throw new Error(body?.error?.message ?? 'Something went wrong. Nothing was charged; try again in a moment.');
				}

				const step = nextStep(body.data, `${location.origin}${location.pathname}`);
				if (step.kind === 'redirect') {
					location.href = step.url;
					return;
				}
				const { payments } = await (await loadSdk()).init({ env: step.options.env, enabledElements: ['payments'] });
				payments.redirectToCheckout(step.options);
			} catch (err) {
				fail(err instanceof Error ? err.message : 'Something went wrong. Nothing was charged.');
			}
		});
	}
</script>
