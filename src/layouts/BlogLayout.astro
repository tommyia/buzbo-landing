---
import FaviconLinks from '../components/FaviconLinks.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { PAGE_SEO, SITE_NAME } from '../lib/seo';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	keywords?: string;
	canonical?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	author?: string;
	footerWaitlistAnchor?: boolean;
	/** After the "·" in the page title. Event pages are not the blog. */
	titleSuffix?: string;
	/** Structured data for a page that is not an article. Overrides the Article block. */
	jsonLd?: Record<string, unknown>;
	/** Structured data added next to the Article (or jsonLd) block, e.g. a post's FAQPage. */
	extraJsonLd?: Record<string, unknown> | null;
	/** e.g. "noindex" for a page that is one person's. */
	robots?: string;
	/** False on a page whose address is a secret: Google Analytics and the Meta Pixel
	 *  both report the full address of the page they load on. */
	analytics?: boolean;
}

const {
	title,
	description,
	keywords = PAGE_SEO.blog.keywords,
	canonical,
	image = PAGE_SEO.blog.image,
	type = 'website',
	publishedTime,
	modifiedTime,
	author,
	footerWaitlistAnchor = true,
	titleSuffix = 'Buzbo Blog',
	jsonLd: pageJsonLd,
	extraJsonLd,
	robots,
	analytics = true,
} = Astro.props;

const fullTitle = `${title} · ${titleSuffix}`;
const imageUrl = image.startsWith('http') ? image : new URL(image, Astro.url.origin).href;
const articleJsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: title,
				description,
				image: imageUrl,
				datePublished: publishedTime || undefined,
				dateModified: modifiedTime || publishedTime || undefined,
				author: author ? { '@type': 'Person', name: author } : { '@type': 'Organization', name: SITE_NAME },
				publisher: {
					'@type': 'Organization',
					name: SITE_NAME,
					logo: { '@type': 'ImageObject', url: new URL('/brand/logo-full-crimson.png', Astro.url.origin).href },
				},
				mainEntityOfPage: canonical || undefined,
			}
		: null;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<FaviconLinks />
		{analytics ? <GoogleAnalytics /> : null}
		{analytics ? <MetaPixel /> : null}
		<meta name="viewport" content="width=device-width" />
		<Seo
			title={fullTitle}
			description={description}
			keywords={keywords}
			canonical={canonical}
			image={image}
			imageAlt={title}
			type={type}
			author={author}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			jsonLd={[pageJsonLd ?? articleJsonLd, extraJsonLd ?? null]}
			robots={robots}
		/>
		<slot name="head" />
	</head>
	<body class="bg-primary-beige font-sans antialiased text-gray-900">
		<SiteHeader />
		<main>
			<slot />
		</main>
		<SiteFooter waitlistAnchor={footerWaitlistAnchor} />
	</body>
</html>
