---
import EventDetailPage from '../../components/events/EventDetailPage.astro';
import { eventsHref } from '../../lib/events/paths';
import { getPublishedEvent } from '../../lib/events/queries';
import { unlistedEventPage } from '../../lib/events/unlisted';

export const prerender = false;

const { slug } = Astro.params;
const ownPage = slug ? unlistedEventPage(slug) : null;
if (ownPage) return Astro.redirect(ownPage);

const event = slug ? await getPublishedEvent(slug) : null;

if (!event) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const canonical = new URL(eventsHref(`/${event.slug}`), Astro.url.origin).href;
---

<EventDetailPage event={event} canonical={canonical} />
