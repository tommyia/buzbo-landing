---
import BlogLayout from '../../layouts/BlogLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import {
	formatDayLong,
	formatPrice,
	formatTimeRange,
	formatUtcOffset,
	isPast,
	mapEmbedUrl,
	safeHttpUrl,
} from '../../lib/events/format';
import { checkoutLabel } from '../../lib/events/checkout';
import { localPriceEstimate, visitorCountry } from '../../lib/events/local-price';
import { checkoutApiUrl, eventsHref } from '../../lib/events/paths';
import { getPublishedEvent, getSoldOut } from '../../lib/events/queries';
import { PAGE_SEO, SITE_NAME } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;
const event = slug ? await getPublishedEvent(slug) : null;

if (!event) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const zone = event.timezone;
const canonical = new URL(eventsHref(`/${event.slug}`), Astro.url.origin).href;
const ended = isPast(event, new Date());

// Everything below comes out of the database and ends up in an href or a src.
const mapUrl = safeHttpUrl(event.map_url);
const mapEmbed = mapEmbedUrl(event);
const cover = safeHttpUrl(event.cover_image_url);

// Buying goes through buzbo-be, which decides the price and whether the ticket can
// still be had; this page only names the ticket and the person.
const checkoutApi = ended ? null : checkoutApiUrl();
const soldOut = checkoutApi ? await getSoldOut(event.id) : new Set<string>();

const country = visitorCountry(Astro.request.headers, Astro.url.searchParams);
const estimateFor = (ticket: { price_cents: number; currency: string }) =>
	localPriceEstimate(ticket.price_cents, ticket.currency, event.fx_rates, country);
const hasEstimate = event.ticket_types.some((ticket) => estimateFor(ticket));

const place = [event.venue_name, event.city].filter(Boolean).join(', ');
const dayLong = formatDayLong(event.starts_at, zone);
const timeRange = `${formatTimeRange(event.starts_at, event.ends_at, zone)} · ${formatUtcOffset(event.starts_at, zone)}`;
const pageTitle = event.seo_title || event.title;
const pageDescription =
	event.seo_description || event.summary || [dayLong, place].filter(Boolean).join(' · ');

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: event.title,
	description: pageDescription,
	startDate: event.starts_at,
	endDate: event.ends_at ?? undefined,
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
	eventStatus: 'https://schema.org/EventScheduled',
	image: cover ?? undefined,
	url: canonical,
	location: event.venue_name
		? {
				'@type': 'Place',
				name: event.venue_name,
				address: event.venue_address ?? event.city ?? undefined,
			}
		: undefined,
	organizer: { '@type': 'Organization', name: SITE_NAME },
	offers: event.ticket_types.map((ticket) => ({
		'@type': 'Offer',
		name: ticket.name,
		price: (ticket.price_cents / 100).toFixed(2),
		priceCurrency: ticket.currency,
		url: canonical,
		availability: soldOut.has(ticket.id) ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
	})),
};

const chip = 'flex items-center gap-3';
---

<BlogLayout
	title={pageTitle}
	description={pageDescription}
	keywords={PAGE_SEO.events.keywords}
	canonical={canonical}
	image={cover ?? PAGE_SEO.events.image}
	titleSuffix="Buzbo Events"
	jsonLd={jsonLd}
>
	<article class="mx-auto max-w-6xl px-6 pt-36 pb-20 lg:px-8 lg:pt-44">
		<a href={eventsHref()} class="text-sm font-semibold text-primary-crimson hover:underline">← All events</a>

		<header class="mt-6 grid items-center gap-8 rounded-3xl bg-beige p-6 sm:p-8 lg:grid-cols-[1fr_20rem] lg:gap-12 lg:p-10">
			<div class="order-2 min-w-0 lg:order-1">
				<p class="text-xs font-semibold uppercase tracking-widest text-primary-crimson">
					Buzbo event{event.city ? ` · ${event.city}` : ''}
				</p>
				<h1 class="mt-3 font-serif text-4xl leading-tight text-burgundy sm:text-5xl">{event.title}</h1>
				<ul class="mt-6 flex flex-col gap-3 text-base font-semibold text-ink">
					<li class={chip}>
						<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 shrink-0 text-primary-crimson">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z" />
						</svg>
						<time datetime={event.starts_at}>{dayLong}</time>
					</li>
					<li class={chip}>
						<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 shrink-0 text-primary-crimson">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" />
						</svg>
						{timeRange}
					</li>
					{place ? (
						<li class={chip}>
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 shrink-0 text-primary-crimson">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" />
							</svg>
							{place}
						</li>
					) : null}
				</ul>
				<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
					{ended ? null : (
						<a href="#tickets" class="inline-flex rounded-full bg-primary-crimson px-7 py-3 text-base font-semibold text-white transition hover:bg-primary-crimson/90">Get your ticket</a>
					)}
					<ShareButtons url={canonical} title={event.title} />
				</div>
			</div>
			<div class="order-1 lg:order-2">
				{cover ? (
					<img src={cover} alt={event.title} class="aspect-square w-full rounded-2xl object-cover shadow-lg shadow-ink/10" />
				) : (
					<div class="aspect-square w-full rounded-2xl bg-cream" aria-hidden="true"></div>
				)}
			</div>
		</header>

		<div class="mt-12 grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-12">
			<aside class="lg:order-2 lg:sticky lg:top-40 lg:self-start">
				<section id="tickets" aria-labelledby="tickets-heading" class="scroll-mt-40 rounded-2xl bg-white p-6 ring-1 ring-line">
					<h2 id="tickets-heading" class="font-sans text-xs font-semibold uppercase tracking-widest text-muted">Tickets</h2>
					<div>
						<ul class="mt-2 divide-y divide-line">
							{event.ticket_types.map((ticket) => (
								<li data-ticket-row={ticket.id} class="-mx-3 flex items-center justify-between gap-4 rounded-xl px-3 py-4 transition-colors duration-200 data-selected:bg-tint">
									<div class="min-w-0">
										<p class="font-semibold text-ink">{ticket.name}</p>
										<p class="mt-0.5 text-sm text-muted">
											{formatPrice(ticket.price_cents, ticket.currency)}
											{estimateFor(ticket) ? <span> ({estimateFor(ticket)})</span> : null}
											{ticket.description ? <span> · {ticket.description}</span> : null}
										</p>
									</div>
									{!checkoutApi ? null : soldOut.has(ticket.id) ? (
										<p class="shrink-0 text-sm font-semibold text-disabled">Sold out</p>
									) : (
										<button
											type="button"
											data-checkout-open
											data-ticket-id={ticket.id}
											data-ticket-name={ticket.name}
											data-ticket-label={checkoutLabel(ticket.price_cents)}
											data-ticket-buddies={ticket.max_buddies}
											aria-pressed="false"
											class="shrink-0 rounded-full bg-burgundy px-4 py-1.5 text-sm font-semibold text-white ring-1 ring-burgundy transition hover:bg-burgundy/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy aria-pressed:bg-white aria-pressed:text-burgundy"
										>
											<span data-ticket-button-label>{checkoutLabel(ticket.price_cents)}</span>
										</button>
									)}
								</li>
							))}
						</ul>
						{hasEstimate ? <p class="mt-1 text-xs text-muted">≈ is an estimate. You see the exact amount at payment.</p> : null}

						{ended ? (
							<p class="mt-2 rounded-xl bg-beige px-4 py-3 text-center text-sm font-semibold text-muted">This event has ended.</p>
						) : checkoutApi ? (
							<form data-checkout-form data-checkout-api={checkoutApi} hidden novalidate class="-mx-3 mt-2 scroll-mt-40 rounded-xl bg-beige px-3 py-4">
								<p class="text-sm text-muted">Your ticket</p>
								<p data-checkout-ticket class="text-base font-semibold text-ink"></p>
								<input type="hidden" name="ticket_type_id" />
								<label class="mt-3 block text-sm font-semibold text-ink" for="checkout-name">Name</label>
								<input id="checkout-name" name="name" type="text" required maxlength="120" autocomplete="name" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy" />
								<label class="mt-3 block text-sm font-semibold text-ink" for="checkout-email">Email</label>
								<input id="checkout-email" name="email" type="email" required maxlength="254" autocomplete="email" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy" />
								<label class="mt-3 block text-sm font-semibold text-ink" for="checkout-email-confirm">Confirm email</label>
								<input id="checkout-email-confirm" name="email_confirm" type="email" required maxlength="254" autocomplete="off" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy aria-invalid:ring-2 aria-invalid:ring-primary-crimson" />
								<p data-confirm-hint hidden class="mt-1 text-sm font-semibold"></p>
								<p class="mt-2 text-sm text-muted">We send your ticket to <strong data-checkout-email-echo class="text-ink">this address</strong>. Check it before you continue.</p>
								<div data-buddy-section hidden class="mt-4">
									<p class="text-sm font-semibold text-ink">Bring a buddy <span class="font-normal text-muted">(optional)</span></p>
									<p data-buddy-note class="mt-1 text-sm text-muted"></p>
									<div data-buddy-rows></div>
									<button type="button" data-buddy-add class="mt-3 rounded-full px-4 py-1.5 text-sm font-semibold text-burgundy ring-1 ring-burgundy transition hover:bg-burgundy/5">Add a buddy</button>
								</div>
								<template data-buddy-template>
									<fieldset data-buddy-row class="mt-3 rounded-lg bg-white p-3 ring-1 ring-line">
										<div class="flex items-center justify-between gap-2">
											<legend data-buddy-title class="text-sm font-semibold text-ink"></legend>
											<button type="button" data-buddy-remove class="text-sm font-semibold text-primary-crimson hover:underline">Remove</button>
										</div>
										<label class="mt-2 block text-sm font-semibold text-ink">Name
											<input data-buddy-name type="text" maxlength="120" autocomplete="off" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base font-normal text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy" />
										</label>
										<label class="mt-2 block text-sm font-semibold text-ink">Email
											<input data-buddy-email type="email" maxlength="254" autocomplete="off" class="mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-base font-normal text-ink ring-1 ring-line focus:ring-2 focus:ring-burgundy" />
										</label>
									</fieldset>
								</template>
								<p data-checkout-currency-note hidden class="mt-2 text-sm text-muted">Prices may be shown in your local currency at payment. Your bank may charge additional fees.</p>
								<p data-checkout-error role="alert" hidden class="mt-3 text-sm font-semibold text-primary-crimson"></p>
								<button type="submit" class="mt-4 flex w-full items-center justify-center rounded-full bg-primary-crimson px-7 py-3 text-base font-semibold text-white transition hover:bg-primary-crimson/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:opacity-60">
									Continue
								</button>
							</form>
						) : null}
					</div>
				</section>
			</aside>

			<div class="min-w-0 lg:order-1">
				{event.description_html ? (
					<section aria-labelledby="about-heading">
						<h2 id="about-heading" class="font-serif text-3xl text-burgundy">About this event</h2>
						{/* Written in buzbo-event's editor, behind the admin password, and trusted
						    as the blog's article bodies are. */}
						<div class="blog-prose mt-4" set:html={event.description_html} />
					</section>
				) : null}

				{place || event.venue_address ? (
					<section aria-labelledby="location-heading" class="mt-12">
						<h2 id="location-heading" class="font-serif text-3xl text-burgundy">Location</h2>
						<div class="mt-4 overflow-hidden rounded-2xl bg-white ring-1 ring-line">
							{mapEmbed ? (
								<iframe
									src={mapEmbed}
									title={`Map of ${event.venue_name ?? event.venue_address ?? event.city}`}
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									class="aspect-video w-full border-0"
								></iframe>
							) : null}
							<div class="flex flex-wrap items-center justify-between gap-3 p-5">
								<div>
									{event.venue_name ? <p class="font-semibold text-ink">{event.venue_name}</p> : null}
									{event.venue_address ? <p class="mt-0.5 text-sm text-muted">{event.venue_address}</p> : null}
									{!event.venue_address && event.city ? <p class="mt-0.5 text-sm text-muted">{event.city}</p> : null}
								</div>
								{mapUrl ? (
									<a href={mapUrl} target="_blank" rel="noopener" class="rounded-full px-4 py-2 text-sm font-semibold text-primary-crimson ring-1 ring-primary-crimson/30 transition hover:bg-primary-crimson/5">Open in Maps</a>
								) : null}
							</div>
						</div>
					</section>
				) : null}
			</div>
		</div>
	</article>
</BlogLayout>

<script>
	// The checkout form: gather a name and an email, ask buzbo-be to hold the ticket, then
	// go where it says — Airwallex's hosted payment page for a paid ticket, the order page
	// for a free one. Card details are typed at Airwallex and never touch this site.
	import { buddyRefusal, checkoutRefusal, nextStep, type CheckoutAnswer } from '../../lib/events/checkout';

	const SDK_URL = 'https://static.airwallex.com/components/sdk/v1/index.js';

	type AirwallexSdk = {
		init(options: { env: string; enabledElements: string[] }): Promise<{
			payments: { redirectToCheckout(options: Record<string, string>): void };
		}>;
	};

	let sdk: Promise<AirwallexSdk> | null = null;
	function loadSdk(): Promise<AirwallexSdk> {
		sdk ??= new Promise((resolve, reject) => {
			const script = document.createElement('script');
			script.src = SDK_URL;
			script.onload = () => resolve((window as unknown as { AirwallexComponentsSDK: AirwallexSdk }).AirwallexComponentsSDK);
			script.onerror = () => {
				sdk = null;
				reject(new Error('The payment page could not be loaded. Check your connection and try again.'));
			};
			document.head.append(script);
		});
		return sdk;
	}

	const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
	if (form) {
		const api = form.dataset.checkoutApi;
		const ticketInput = form.elements.namedItem('ticket_type_id') as HTMLInputElement;
		const nameInput = form.elements.namedItem('name') as HTMLInputElement;
		const emailInput = form.elements.namedItem('email') as HTMLInputElement;
		const confirmInput = form.elements.namedItem('email_confirm') as HTMLInputElement;
		const confirmHint = form.querySelector<HTMLElement>('[data-confirm-hint]')!;
		const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const errorBox = form.querySelector<HTMLElement>('[data-checkout-error]')!;
		const ticketName = form.querySelector<HTMLElement>('[data-checkout-ticket]')!;
		const emailEcho = form.querySelector<HTMLElement>('[data-checkout-email-echo]')!;
		// Airwallex's payment page may offer the buyer their own currency; a free ticket never reaches it.
		const currencyNote = form.querySelector<HTMLElement>('[data-checkout-currency-note]')!;
		const buddySection = form.querySelector<HTMLElement>('[data-buddy-section]')!;
		const buddyNote = form.querySelector<HTMLElement>('[data-buddy-note]')!;
		const buddyRows = form.querySelector<HTMLElement>('[data-buddy-rows]')!;
		const buddyAdd = form.querySelector<HTMLButtonElement>('[data-buddy-add]')!;
		const buddyTemplate = form.querySelector<HTMLTemplateElement>('[data-buddy-template]')!;
		let submitLabel = 'Continue';
		let maxBuddies = 0;

		// Numbered again after every change, and the add button goes at the limit.
		const refreshBuddies = () => {
			const rows = [...buddyRows.querySelectorAll<HTMLElement>('[data-buddy-row]')];
			rows.forEach((row, index) => {
				row.querySelector<HTMLElement>('[data-buddy-title]')!.textContent = maxBuddies > 1 ? `Buddy ${index + 1}` : 'Your buddy';
			});
			buddyAdd.hidden = rows.length >= maxBuddies;
		};

		// Another ticket may allow fewer: what no longer fits must not be sent.
		const setBuddyLimit = (limit: number) => {
			maxBuddies = limit;
			buddySection.hidden = limit === 0;
			buddyNote.textContent = `This ticket includes up to ${limit} ${limit === 1 ? 'buddy' : 'buddies'} at no extra cost. Each buddy gets their own ticket by email. You can't add one after checkout.`;
			const rows = [...buddyRows.querySelectorAll<HTMLElement>('[data-buddy-row]')];
			rows.slice(limit).forEach((row) => row.remove());
			refreshBuddies();
		};

		buddyAdd.addEventListener('click', () => {
			const row = buddyTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
			row.querySelector('[data-buddy-remove]')!.addEventListener('click', () => {
				row.remove();
				refreshBuddies();
				buddyAdd.focus();
			});
			buddyRows.append(row);
			refreshBuddies();
			row.querySelector<HTMLInputElement>('[data-buddy-name]')!.focus();
		});

		const fail = (message: string) => {
			errorBox.textContent = message;
			errorBox.hidden = false;
			submit.disabled = false;
			submit.textContent = submitLabel;
		};

		const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-checkout-open]')];

		// Play an entrance animation again, even on an element that already ran it.
		const replay = (element: HTMLElement) => {
			element.classList.remove('animate-rise');
			void element.offsetWidth;
			element.classList.add('animate-rise');
		};

		for (const button of buttons) {
			button.addEventListener('click', () => {
				// Mark the chosen ticket, and only that one.
				for (const other of buttons) {
					const chosen = other === button;
					other.setAttribute('aria-pressed', String(chosen));
					other.querySelector<HTMLElement>('[data-ticket-button-label]')!.textContent = chosen
						? 'Selected'
						: (other.dataset.ticketLabel ?? '');
					other.closest('[data-ticket-row]')?.toggleAttribute('data-selected', chosen);
				}
				ticketInput.value = button.dataset.ticketId ?? '';
				ticketName.textContent = button.dataset.ticketName ?? '';
				setBuddyLimit(Number(button.dataset.ticketBuddies ?? '0'));
				submitLabel = button.dataset.ticketLabel === 'Register' ? 'Register' : 'Continue to payment';
				currencyNote.hidden = submitLabel === 'Register';
				submit.textContent = submitLabel;
				errorBox.hidden = true;
				const opening = form.hidden;
				form.hidden = false;
				replay(opening ? form : ticketName);
				form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				if (opening) nameInput.focus({ preventScroll: true });
			});
		}

		// Tell the buyer as soon as the two addresses differ, not only on submit.
		const checkConfirm = (final: boolean) => {
			const email = emailInput.value.trim().toLowerCase();
			const confirm = confirmInput.value.trim().toLowerCase();
			if (!confirm || (!final && confirm.length < email.length)) {
				confirmHint.hidden = true;
				confirmInput.removeAttribute('aria-invalid');
				return;
			}
			const same = confirm === email;
			confirmHint.hidden = false;
			confirmHint.textContent = same ? 'Email addresses match.' : 'The email addresses do not match.';
			confirmHint.className = `mt-1 text-sm font-semibold ${same ? 'text-success' : 'text-primary-crimson'}`;
			if (same) confirmInput.removeAttribute('aria-invalid');
			else confirmInput.setAttribute('aria-invalid', 'true');
		};
		confirmInput.addEventListener('input', () => checkConfirm(false));
		confirmInput.addEventListener('blur', () => checkConfirm(true));
		emailInput.addEventListener('input', () => {
			if (confirmInput.value) checkConfirm(false);
		});

		// Back from Airwallex restores this page as it was left: button disabled, "One
		// moment…". Put it back so the buyer can try again.
		window.addEventListener('pageshow', (event) => {
			if (!event.persisted) return;
			submit.disabled = false;
			submit.textContent = submitLabel;
		});

		emailInput.addEventListener('input', () => {
			emailEcho.textContent = emailInput.value.trim() || 'this address';
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			errorBox.hidden = true;
			const refusal = checkoutRefusal({
				name: nameInput.value,
				email: emailInput.value,
				confirmEmail: confirmInput.value,
				emailValid: emailInput.checkValidity(),
			});
			if (refusal && confirmInput.value.trim() && refusal.includes('do not match')) {
				// Already said under the field; point there instead of saying it twice.
				checkConfirm(true);
				confirmInput.focus();
				return;
			}
			if (refusal) return fail(refusal);

			const buddies = [...buddyRows.querySelectorAll<HTMLElement>('[data-buddy-row]')].map((row) => {
				const email = row.querySelector<HTMLInputElement>('[data-buddy-email]')!;
				return {
					name: row.querySelector<HTMLInputElement>('[data-buddy-name]')!.value,
					email: email.value,
					emailValid: email.checkValidity(),
				};
			});
			const buddyProblem = buddyRefusal(buddies, emailInput.value);
			if (buddyProblem) return fail(buddyProblem);

			// Disabled before the request, so a second click cannot hold a second ticket.
			submit.disabled = true;
			submit.textContent = 'One moment…';
			try {
				const response = await fetch(`${api}/api/payments/checkout`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						ticket_type_id: ticketInput.value,
						name: nameInput.value,
						email: emailInput.value,
						buddies: buddies.map(({ name, email }) => ({ name, email })),
					}),
				});
				const body = (await response.json().catch(() => null)) as {
					data: CheckoutAnswer | null;
					error: { message?: string } | null;
				} | null;
				if (response.status === 400) {
					// buzbo-be's own wording here is "Request validation failed".
					throw new Error('Check the names and email addresses. A name cannot contain a web address.');
				}
				if (!response.ok || !body?.data) {
					throw new Error(body?.error?.message ?? 'Something went wrong. Nothing was charged; try again in a moment.');
				}

				const step = nextStep(body.data, `${location.origin}${location.pathname}`);
				if (step.kind === 'redirect') {
					location.href = step.url;
					return;
				}
				const { payments } = await (await loadSdk()).init({ env: step.options.env, enabledElements: ['payments'] });
				payments.redirectToCheckout(step.options);
			} catch (err) {
				fail(err instanceof Error ? err.message : 'Something went wrong. Nothing was charged.');
			}
		});
	}
</script>

