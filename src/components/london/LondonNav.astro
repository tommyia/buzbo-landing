---
import { LONDON_SITE_URL as L, LONDON_SOCIAL as SOCIAL } from '../../lib/events/london';

const links = [
	{ href: `${L}/#mission`, label: 'Our Mission' },
	{ href: `${L}/#london`, label: 'The Proof' },
	{ href: `${L}/#how`, label: 'How It Works' },
	{ href: `${L}/events`, label: 'Events' },
];
---

<header class="pad-x flex h-14 items-center justify-between gap-x-6 bg-beige/95 shadow-md shadow-ink/10 backdrop-blur-md lg:h-20">
	<div class="flex flex-1 items-center">
		<button type="button" data-menu-open class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-muted lg:hidden">
			<span class="sr-only">Open main menu</span>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
				<path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
		<nav aria-label="Global" class="hidden gap-x-8 text-sm/6 font-semibold uppercase lg:flex xl:gap-x-12">
			{links.map((link) => <a href={link.href} class="whitespace-nowrap text-ink hover:text-burgundy">{link.label}</a>)}
		</nav>
	</div>

	<a href={L} class="flex shrink-0">
		<span class="sr-only">BUZBO home</span>
		<img src="/brand/logo-full-crimson.png" alt="BUZBO" width="6000" height="3375" class="h-14 w-auto lg:h-20" />
	</a>

	<div class="flex flex-1 items-center justify-end gap-x-4">
		<a href={SOCIAL.linkedin} target="_blank" rel="noopener" class="hidden text-burgundy lg:block">
			<span class="sr-only">LinkedIn</span>
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-6">
				<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
			</svg>
		</a>
		<a href={SOCIAL.instagram} target="_blank" rel="noopener" class="hidden text-burgundy lg:block">
			<span class="sr-only">Instagram</span>
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-6">
				<path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" fill-rule="evenodd" />
			</svg>
		</a>
		<a href={`${L}/#signup`} class="hidden whitespace-nowrap rounded-full bg-burgundy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-burgundy/90 sm:block">Join the waitlist</a>
	</div>

	<dialog id="mobile-menu" class="mobile-menu lg:hidden">
		<div class="flex h-full flex-col bg-cream p-6">
			<div class="flex items-center justify-between border-b border-burgundy/10 pb-5">
				<a href={L} data-menu-link class="-m-1.5 p-1.5">
					<span class="sr-only">BUZBO home</span>
					<img src="/brand/logo-full-crimson.png" alt="BUZBO" width="6000" height="3375" class="h-10 w-auto" />
				</a>
				<button type="button" data-menu-close class="-m-2.5 rounded-full p-2.5 text-burgundy transition hover:bg-burgundy/10">
					<span class="sr-only">Close menu</span>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" class="size-6">
						<path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</div>
			<nav aria-label="Mobile" class="mt-6 flex flex-col gap-1">
				{links.map((link) => (
					<a href={link.href} data-menu-link class="flex items-center justify-between rounded-xl px-4 py-3.5 text-lg font-semibold text-ink transition hover:bg-burgundy/5 hover:text-burgundy">
						{link.label}
						<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4 text-burgundy/40">
							<path d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" fill-rule="evenodd"></path>
						</svg>
					</a>
				))}
			</nav>
			<div class="mt-6 flex gap-x-6 px-4 text-base font-semibold text-burgundy">
				<a href={SOCIAL.linkedin} target="_blank" rel="noopener" data-menu-link>LinkedIn</a>
				<a href={SOCIAL.instagram} target="_blank" rel="noopener" data-menu-link>Instagram</a>
			</div>
			<div class="mt-auto pt-8">
				<a href={`${L}/#signup`} data-menu-link class="flex w-full items-center justify-center rounded-full bg-burgundy px-7 py-3 text-lg font-semibold text-white transition hover:bg-burgundy/90">Join the waitlist</a>
			</div>
		</div>
	</dialog>
</header>

<script is:inline>
	(function () {
		var dialog = document.getElementById('mobile-menu');
		if (!dialog) return;
		var openBtn = document.querySelector('[data-menu-open]');

		function openMenu() { if (!dialog.open) dialog.showModal(); }
		function closeMenu() { if (dialog.open) dialog.close(); }

		if (openBtn) openBtn.addEventListener('click', openMenu);

		dialog.addEventListener('click', function (e) {
			if (e.target === dialog) { closeMenu(); return; }
			if (e.target.closest('[data-menu-link], [data-menu-close]')) closeMenu();
		});
	})();
</script>
