---
import BlogLayout from '../../layouts/BlogLayout.astro';
import IntroducingApp from '../../components/IntroducingApp.astro';
import TeamBanner from '../../components/TeamBanner.astro';
import { getPublicSupabase, isSupabaseConfigured, type Article } from '../../lib/supabase';
import { PAGE_SEO } from '../../lib/seo';

export const prerender = false;

let articles: Article[] = [];

if (isSupabaseConfigured()) {
	const supabase = getPublicSupabase();
	const { data } = await supabase
		.from('buzbo_landing_article')
		.select(
			'id, title, slug, excerpt, cover_image_url, author_name, reading_duration_minutes, published_at',
		)
		.eq('status', 'published')
		.order('published_at', { ascending: false });
	articles = (data ?? []) as Article[];
}

function formatDate(value: string | null) {
	if (!value) return '';
	return new Date(value).toLocaleDateString('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
	});
}
---

<BlogLayout
	title={PAGE_SEO.blog.title}
	description={PAGE_SEO.blog.description}
	keywords={PAGE_SEO.blog.keywords}
	image={PAGE_SEO.blog.image}
	footerWaitlistAnchor={false}
>
	<section class="relative isolate overflow-hidden">
		<img
			src="/blog-banner.png"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 size-full object-cover object-[70%_center]"
		/>
		<div class="absolute inset-0 bg-black/50" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-7xl px-6 pt-36 pb-16 sm:pb-20 lg:px-8 lg:pt-44 lg:pb-24">
			<div class="max-w-2xl text-left">
				<h1 class="text-pretty text-4xl font-extrabold tracking-tight text-primary-beige sm:text-6xl lg:text-7xl font-sans">
					What we're<br />
					<span class="italic font-normal font-serif">thinking about.</span>
				</h1>
				<p class="mt-6 text-pretty text-base font-normal text-primary-beige sm:text-lg/8">
					Your CV says what you've done. It doesn't say who you are. Buzbo is a skills-based networking platform that actually shows that: your skills, what you're into, the work you're proud of. Companies looking for real fit find you here, not just people who tick boxes. Drop your name and email below and you're in when we launch.
				</p>
			</div>
		</div>
	</section>

	<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		{articles.length === 0 ? (
			<p class="mx-auto max-w-3xl rounded-2xl bg-white/70 px-6 py-12 text-center text-gray-600">
				No published articles yet. Check back soon.
			</p>
		) : (
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{articles.map((article) => (
				<a
					href={`/blog/${article.slug}`}
					class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-primary-crimson/10 transition hover:-translate-y-1 hover:shadow-md"
				>
					{article.cover_image_url ? (
						<img
							src={article.cover_image_url}
							alt=""
							class="aspect-[16/9] w-full object-cover"
						/>
					) : (
						<div class="aspect-[16/9] w-full bg-step-card" aria-hidden="true"></div>
					)}
					<div class="flex flex-1 flex-col p-6">
						<h2 class="font-serif text-xl text-primary-crimson group-hover:underline sm:text-2xl">{article.title}</h2>
						{article.excerpt ? (
							<p class="mt-3 line-clamp-3 text-sm/6 text-gray-700">{article.excerpt}</p>
						) : null}
						<div class="mt-auto flex flex-wrap items-center gap-x-2 pt-4 text-xs font-medium tracking-wide text-primary-mauve">
							{article.published_at ? (
								<time datetime={article.published_at}>{formatDate(article.published_at)}</time>
							) : null}
							{article.published_at && article.reading_duration_minutes ? <span aria-hidden="true">·</span> : null}
							{article.reading_duration_minutes ? (
								<span>{article.reading_duration_minutes} min read</span>
							) : null}
						</div>
					</div>
				</a>
			))}
			</div>
		)}
	</div>

	<section class="bg-primary-beige py-24 sm:py-32">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<IntroducingApp />
		</div>
	</section>

	<TeamBanner class="pb-16 sm:pb-24" />
</BlogLayout>

