---
import { APP_STORE_URL, PLAY_STORE_URL } from '../lib/stores';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const badge = 'inline-flex h-14 items-center gap-3 rounded-xl bg-cream px-5 text-burgundy ring-1 ring-burgundy transition hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy';
---

<div class:list={['flex flex-wrap gap-3', className]}>
	<a href={APP_STORE_URL} target="_blank" rel="noopener" data-store="app_store" class={badge} aria-label="Download on the App Store">
		<svg viewBox="0 0 384 512" fill="currentColor" aria-hidden="true" class="size-7">
			<path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
		</svg>
		<span class="flex flex-col text-left leading-none">
			<span class="text-[11px] font-medium">Download on the</span>
			<span class="mt-1 text-xl font-semibold tracking-tight">App Store</span>
		</span>
	</a>
	<a href={PLAY_STORE_URL} target="_blank" rel="noopener" data-store="google_play" class={badge} aria-label="Get it on Google Play">
		<svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true" class="size-6">
			<path d="M325.3 234.3 104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z" />
		</svg>
		<span class="flex flex-col text-left leading-none">
			<span class="text-[11px] font-medium uppercase">Get it on</span>
			<span class="mt-1 text-xl font-semibold tracking-tight">Google Play</span>
		</span>
	</a>
</div>
<script is:inline>
	document.querySelectorAll('[data-store]').forEach(function (link) {
		if (link.dataset.tracked) return;
		link.dataset.tracked = '1';
		link.addEventListener('click', function () {
			if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: link.dataset.store });
			if (typeof gtag === 'function') gtag('event', 'app_download_click', { store: link.dataset.store });
		});
	});
</script>
