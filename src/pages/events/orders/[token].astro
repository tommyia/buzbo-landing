---
import OrderTicket from '../../../components/events/OrderTicket.astro';
import PurchaseHandoff from '../../../components/events/PurchaseHandoff.astro';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { fetchOrder, nextRefresh, questionnaireLink, withLaterLink } from '../../../lib/events/order';
import { checkoutApiUrl, eventsHref } from '../../../lib/events/paths';
import { purchaseHandoff } from '../../../lib/events/purchase';

export const prerender = false;

// One person's ticket. Nothing here may be cached or indexed.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const api = checkoutApiUrl();
const result = api && Astro.params.token ? await fetchOrder(api, Astro.params.token) : { kind: 'unknown' as const };

if (result.kind === 'unknown') {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

// While the payment settles — or while buzbo-be cannot be reached — the page reloads
// itself, with no script: a meta refresh that counts its own attempts in the address.
const attempt = Number(Astro.url.searchParams.get('n') ?? '0');

if (result.kind === 'unavailable') {
	// Not "not found": this may be somebody who has just paid.
	Astro.response.status = 503;
}
const order = result.kind === 'found' ? result.order : null;

// Straight from checkout: on to the questionnaire as soon as the ticket exists.
const welcome = Astro.url.searchParams.get('welcome') === '1';
const ticketPage = `${Astro.url.origin}${Astro.url.pathname}`;
// First, once, the Meta Purchase event on a page of its own; it then moves on itself.
const handoff = order && welcome ? purchaseHandoff(order, ticketPage, eventsHref(`/${order.event.slug}`)) : null;
const questionnaire = order && welcome && !handoff ? questionnaireLink(order) : null;
if (questionnaire) {
	return Astro.redirect(withLaterLink(questionnaire, ticketPage), 302);
}
---

{order === null ? (
	<BlogLayout title="Your order" description="Your Buzbo event ticket." titleSuffix="Buzbo Events" robots="noindex, nofollow" analytics={false}>
		<Fragment slot="head">
			<meta name="referrer" content="no-referrer" />
			{nextRefresh(attempt) !== null ? <meta http-equiv="refresh" content={`3;url=?n=${nextRefresh(attempt)}${welcome ? '&welcome=1' : ''}`} /> : null}
		</Fragment>
		<article class="mx-auto max-w-xl px-6 pt-36 pb-20 lg:pt-44">
			<section class="rounded-2xl bg-white px-6 py-8 text-center ring-1 ring-line" aria-live="polite">
				<p class="font-semibold text-ink">We are fetching your order…</p>
				<p class="mt-2 text-sm text-muted">This page refreshes by itself. If you paid, your ticket is safe and will also arrive by email.</p>
			</section>
		</article>
	</BlogLayout>
) : handoff ? (
	<PurchaseHandoff order={order} handoff={handoff} />
) : (
	<OrderTicket order={order} attempt={attempt} welcome={welcome} />
)}
